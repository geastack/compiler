{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "jsxImportSource": "framework",
    "baseUrl": ".",
    "paths": { "framework/jsx-runtime": ["./jsx-runtime.ts"], "framework": ["./jsx-runtime.ts"] }
  },
  "include": ["**/*.ts", "**/*.tsx"]
}
