node_modules
dist

# Agent scratch. Grows without bound and is reproducible from source.
.scratch
.DS_Store

# Measurement records: `scripts/corpus.mjs <label>` writes one JSON per run plus
# the emitted C++ of every program under `measurements/cxx/`. Half a gigabyte,
# regenerated by re-running the harness, and a diff of them says nothing a fresh
# run does not. The compass is the harness, not a committed snapshot of it.
measurements/*
!measurements/.gitkeep

# The compiler's own working directory: tsconfigs the corpus harness generates
# per app, plus whatever an emit or a link-and-run leaves behind -- emitted C++,
# copied runtime headers, `program` and its dSYM, and `mkdtemp`-named run
# directories. All of it is regenerated by re-running the harness, and none of
# it is an input.
projects/

# Upstream tc39/test262 checkout, restored from the July 2026 sweep source
# archive. 224 MB, reproducible.
vendor/test262/

# Sweep run state (229MB of cached cloud-run artifacts), not source.
cloud-run-ts-sweep/

# The CommonJS module-record fixtures resolve a real package through node_modules;
# this one is test data, not an install.
!test/fixtures/commonjs-module-record/node_modules/
!test/fixtures/commonjs-module-record/fastify-js/node_modules/
